# Documentation only: export chosen values before START_APP.sh.
BBS_PYTHON=python3
BBS_VENV=.venv
BBS_HOST=0.0.0.0
BBS_PORT=8502
BBS_MODEL_DIR=data/models
BBS_AUDIO_CACHE=data/audio_cache
BBS_TTS_THREADS=2
# Optional premium audio is off by default. Never put a real key in this file.
BBS_ENABLE_OPENAI=0
OPENAI_API_KEY=
BBS_OPENAI_MODEL=gpt-4o-mini-tts
# Private creature importer defaults to skipping robots; true enables enforcement.
IMPORT_RESPECT_ROBOTS=false
BBS_CREATURE_IMAGE_DIR=data/creature_images

# Separate, optional local CPU image runtime/model/cache.
BBS_IMAGE_VENV=.venv-images
BBS_IMAGE_MODEL_DIR=data/models/illustrations
BBS_IMAGE_DIR=data/generated_images

# Persistent chapter audio is separate from the clearable narration cache.
BBS_CHAPTER_AUDIO=data/chapter_audio
